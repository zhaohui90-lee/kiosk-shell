{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "jsx": "preserve",
