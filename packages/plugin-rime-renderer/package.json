{
  "name": "@kiosk/plugin-rime-renderer",
  "version": "1.0.0",
  "description": "Virtual keyboard UI renderer for kiosk IME",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
