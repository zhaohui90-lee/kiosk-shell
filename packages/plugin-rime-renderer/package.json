  },
  "dependencies": {
    "@kiosk/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
"vite-plugin-dts": "^4.3.0",
    "vitest": "^1.0.0",
    "vue": "^3.5.13"
  },
  "files": [
    "dist"
  ],
